# Carpeta donde se guardan las instantáneas descargadas de MITECO (auditoría y arranque en frío).
REPOSTA_DATA_DIR=../../data
# Minutos entre refrescos del precio actual (la fuente publica cada ~30 min).
REPOSTA_REFRESH_MIN=30

# Motor de rutas OSRM. El servidor público es solo para desarrollo; en producción, uno propio.
REPOSTA_ROUTING_URL=https://router.project-osrm.org

# Rutas con OpenRouteService (recomendado en producción). Clave gratuita en https://openrouteservice.org/dev/#/signup
# Si está vacía se usa REPOSTA_ROUTING_URL (OSRM).
ORS_API_KEY=

# Política de privacidad
NEXT_PUBLIC_OWNER_NAME=
NEXT_PUBLIC_CONTACT_EMAIL=

# App Android (PWABuilder / Trusted Web Activity)
ANDROID_PACKAGE=
ANDROID_SHA256=

# URL pública (metadatos)
NEXT_PUBLIC_SITE_URL=https://reposta.es
